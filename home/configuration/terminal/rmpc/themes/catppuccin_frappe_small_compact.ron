#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    draw_borders: false,
    browser_column_widths: [20, 38, 42],
    background_color: "#303446",
    modal_backdrop: true,
    text_color: "#c6d0f5",
    header_background_color: "#303446",
    modal_background_color: "#414559",
    preview_label_style: (fg: "#e5c890"),
    preview_metadata_group_style: (fg: "#e5c890"),
    song_table_album_separator: None,
    tab_bar: (
      active_style: (fg: "#303446", bg: "#babbf1", modifiers: "Bold"),
      inactive_style: (),
    ),
    highlighted_item_style: (fg: "#e5c890"),
    current_item_style: (fg: "#303446", bg: "#b7bdf8"),
    borders_style: (fg: "#737994"),
    highlight_border_style: (fg: "#737994"),
    symbols: (
      song: "󰝚 ", dir: "", playlist: "󰲸 ", marker: "* ", ellipsis: "...",
      song_style: (fg: "#8caaee"), 
      dir_style: (fg: "#e5c890"),
      playlist_style: (fg: "#a6d189"),
    ),
    progress_bar: (
      symbols: ["", "█", "", "█", "" ],
      use_track_when_empty: false,
      track_style: (fg: "#626880", bg: None),
      elapsed_style: (fg: "#babbf1", bg: None),
      thumb_style: (fg: "#babbf1", bg: "#626880"),
    ),
    scrollbar: (
      symbols: ["┋", "█", "󰶼", "󰶹"],
      track_style: (fg: "#b7bdf8"),
      ends_style: (fg: "#b7bdf8"),
      thumb_style: (fg: "#b7bdf8"),
    ),
    song_table_format: [
      (
        label_prop: (kind: Text("#"), style: (fg: "#838ba7")), 
        prop: (kind: Property(Position), style: (fg: "#c6d0f5"), default: (kind: Text("?"))),
        width: "4"
      ),
      (
        label_prop: (kind: Text("Title"), style: (fg: "#838ba7")), 
        prop: (kind: Property(Title), style: (fg: "#c6d0f5"), default: (kind: Property(Filename))),
        width: "100%"
      ),
      (
        label_prop: (kind: Text(""), style: (fg: "#838ba7")), 
        prop: 
        (kind: Transform(Replace(content: (kind: Sticker("rating")), replacements: [
          (match: "1", replace: (kind: Text("1"), style: (fg: "#e5c890"))),
          (match: "2", replace: (kind: Text("2"), style: (fg: "#e5c890"))),
          (match: "3", replace: (kind: Text("3"), style: (fg: "#e5c890"))),
          (match: "4", replace: (kind: Text("4"), style: (fg: "#e5c890"))),
          (match: "5", replace: (kind: Text("5"), style: (fg: "#e5c890"))),
        ])), default: (kind: Text("-"), style: (fg: "#626880"))),
        width: "3", alignment: Right
      ),
      (
        label_prop: (kind: Text("Time"), style: (fg: "#838ba7")), 
        prop: (kind: Property(Duration), style: (fg: "#c6d0f5"), default: (kind: Text("-"))),
        width: "6", alignment: Right
      ),
    ],
    layout: Split(
      direction: Vertical, panes: [
        (size: "3", borders: "ALL", border_symbols: Rounded, pane: Component("tabs")),
        (size: "100%", pane: Pane(TabContent)),
        (size: "8", borders: "ALL", border_symbols: Rounded, pane: Split(direction: Horizontal, panes: [
          (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
          (size: "100%", pane: Component("footer")),
          (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
        ])),
        (size: "3", borders: "ALL", border_symbols: Rounded, pane: Component("progress")),
      ]),
    browser_song_format: [
      (kind: Group([
        (kind: Property(Track)),
        (kind: Text(" ")),
      ])),
      (kind: Group([
        (kind: Property(Artist)),
        (kind: Text(" - ")),
        (kind: Property(Title)),
      ]), default: (kind: Property(Filename)))
    ],
    level_styles: (
      info:  (fg: "#a6d189", bg: "#626880"),
      warn:  (fg: "#e5c890", bg: "#626880"),
      error: (fg: "#e78284", bg: "#626880"),
      debug: (fg: "#a6d189", bg: "#626880"),
      trace: (fg: "#f4b8e4", bg: "#626880"),
    ),
    components: {
      "tabs": Pane(Property(content: [
        (kind: Transform(Replace(content: (kind: Property(Status(ActiveTab))), replacements: [
          (match: "Home", replace: (kind: Group([(kind: Text(" Home "), style: (fg: "#303446", bg: "#babbf1", modifiers: "Bold")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Directories "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Playlists "), style: (fg: "#c6d0f5"))]))),
          (match: "Directories", replace: (kind: Group([(kind: Text(" Home "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Directories "), style: (fg: "#303446", bg: "#babbf1", modifiers: "Bold")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Playlists "), style: (fg: "#c6d0f5"))]))),
          (match: "Playlists", replace: (kind: Group([(kind: Text(" Home "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Directories "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Playlists "), style: (fg: "#303446", bg: "#babbf1", modifiers: "Bold"))]))),
          (match: "Albums", replace: (kind: Group([(kind: Text(" Home "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Directories "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Playlists "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Albums "), style: (fg: "#303446", bg: "#babbf1", modifiers: "Bold"))]))),
          (match: "Album Artists", replace: (kind: Group([(kind: Text(" Home "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Directories "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Playlists "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Album Artists "), style: (fg: "#303446", bg: "#babbf1", modifiers: "Bold"))]))),
          (match: "Genre", replace: (kind: Group([(kind: Text(" Home "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Directories "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Playlists "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Genre "), style: (fg: "#303446", bg: "#babbf1", modifiers: "Bold"))]))),
          (match: "Search", replace: (kind: Group([(kind: Text(" Home "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Directories "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Playlists "), style: (fg: "#c6d0f5")), (kind: Text("   "), style: (fg: "#c6d0f5")), (kind: Text(" Search "), style: (fg: "#303446", bg: "#babbf1", modifiers: "Bold"))]))),
        ])), default: (kind: Text(""))),
      ], align: Center)),
      "progress": Split(direction: Horizontal, panes: [
        (size: "3", pane: Pane(Property(content: [
          (kind: Property(Status(StateV2(playing_label: "  ", paused_label: "  ", stopped_label: "  "))), style: (fg: "#c6d0f5")),
        ]))),
        (size: "100%", pane: Pane(ProgressBar)),
        (size: "17", pane: Pane(Property(content: [
          (kind: Text(" [ "), style: (fg: "#babbf1", modifiers: "Bold")),
          (kind: Property(Status(Elapsed)), style: (fg: "#c6d0f5")),
          (kind: Text(" / "), style: (fg: "#babbf1", modifiers: "Bold")),
          (kind: Property(Status(Duration)), style: (fg: "#c6d0f5")),
          (kind: Text(" ] "), style: (fg: "#babbf1", modifiers: "Bold")),
        ], align: Right))),
      ]),
      "footer": Split(direction: Vertical, panes: [
      (size: "1", pane: Split(direction: Horizontal, panes: [
        (size: "100%", pane: Pane(Property(content: [
            (kind: Property(Song(Title)), style: (fg: "#e5c890", modifiers: "Bold"), default: (kind: Text("No Song"), style: (fg: "#c6d0f5"))),
          ], align: Left))),
        (size: "15", pane: Pane(Property(content: [
            (kind: Text("song "), style: (fg: "#838ba7")),
            (kind: Transform(Replace(content: (kind: Sticker("rating")), replacements: [
              (match: "0", replace: (kind: Group([(kind: Text("    "), style: (fg: "#626880"))]))),
              (match: "1", replace: (kind: Group([(kind: Text(" "), style: (fg: "#e5c890")), (kind: Text("   "), style: (fg: "#626880"))]))),
              (match: "2", replace: (kind: Group([(kind: Text("  "), style: (fg: "#e5c890")), (kind: Text("  "), style: (fg: "#626880"))]))),
              (match: "3", replace: (kind: Group([(kind: Text("   "), style: (fg: "#e5c890")), (kind: Text(" "), style: (fg: "#626880"))]))),
              (match: "4", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890")), (kind: Text(""), style: (fg: "#626880"))]))),
              (match: "5", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890"))]))),
            ])), default: (kind: Group([(kind: Text("    "), style: (fg: "#626880"))]))),
          ], align: Right))),
      ])),
      (size: "1", pane: Pane(Property(content: [
            (kind: Property(Song(Artist)), style: (fg: "#c6d0f5"), default: (kind: Text("Unknown Artist"), style: (fg: "#c6d0f5"))),
          ], align: Left))),
      (size: "1", pane: Split(direction: Horizontal, panes: [
        (size: "100%", pane: Pane(Property(content: [
            (kind: Property(Song(Album)), style: (fg: "#a5adce"), default: (kind: Text("Unknown Album"), style: (fg: "#a5adce"))),
          ], align: Left))),
        (size: "16", pane: Pane(Property(content: [
            (kind: Text("album "), style: (fg: "#838ba7")),
            (kind: Transform(Replace(content: (kind: Sticker("albumRating")), replacements: [
              (match: "1", replace: (kind: Group([(kind: Text(" "), style: (fg: "#e5c890")), (kind: Text("   "), style: (fg: "#626880"))]))),
              (match: "1.1", replace: (kind: Group([(kind: Text(" "), style: (fg: "#e5c890")), (kind: Text("   "), style: (fg: "#626880"))]))),
              (match: "1.2", replace: (kind: Group([(kind: Text(" "), style: (fg: "#e5c890")), (kind: Text("   "), style: (fg: "#626880"))]))),
              (match: "1.3", replace: (kind: Group([(kind: Text("  "), style: (fg: "#e5c890")), (kind: Text("  "), style: (fg: "#626880"))]))),
              (match: "1.4", replace: (kind: Group([(kind: Text("  "), style: (fg: "#e5c890")), (kind: Text("  "), style: (fg: "#626880"))]))),
              (match: "1.5", replace: (kind: Group([(kind: Text("  "), style: (fg: "#e5c890")), (kind: Text("  "), style: (fg: "#626880"))]))),
              (match: "1.6", replace: (kind: Group([(kind: Text("  "), style: (fg: "#e5c890")), (kind: Text("  "), style: (fg: "#626880"))]))),
              (match: "1.7", replace: (kind: Group([(kind: Text("  "), style: (fg: "#e5c890")), (kind: Text("  "), style: (fg: "#626880"))]))),
              (match: "1.8", replace: (kind: Group([(kind: Text("  "), style: (fg: "#e5c890")), (kind: Text("  "), style: (fg: "#626880"))]))),
              (match: "1.9", replace: (kind: Group([(kind: Text("  "), style: (fg: "#e5c890")), (kind: Text("  "), style: (fg: "#626880"))]))),
              (match: "2", replace: (kind: Group([(kind: Text("  "), style: (fg: "#e5c890")), (kind: Text("  "), style: (fg: "#626880"))]))),
              (match: "2.1", replace: (kind: Group([(kind: Text("  "), style: (fg: "#e5c890")), (kind: Text("  "), style: (fg: "#626880"))]))),
              (match: "2.2", replace: (kind: Group([(kind: Text("  "), style: (fg: "#e5c890")), (kind: Text("  "), style: (fg: "#626880"))]))),
              (match: "2.3", replace: (kind: Group([(kind: Text("   "), style: (fg: "#e5c890")), (kind: Text(" "), style: (fg: "#626880"))]))),
              (match: "2.4", replace: (kind: Group([(kind: Text("   "), style: (fg: "#e5c890")), (kind: Text(" "), style: (fg: "#626880"))]))),
              (match: "2.5", replace: (kind: Group([(kind: Text("   "), style: (fg: "#e5c890")), (kind: Text(" "), style: (fg: "#626880"))]))),
              (match: "2.6", replace: (kind: Group([(kind: Text("   "), style: (fg: "#e5c890")), (kind: Text(" "), style: (fg: "#626880"))]))),
              (match: "2.7", replace: (kind: Group([(kind: Text("   "), style: (fg: "#e5c890")), (kind: Text(" "), style: (fg: "#626880"))]))),
              (match: "2.8", replace: (kind: Group([(kind: Text("   "), style: (fg: "#e5c890")), (kind: Text(" "), style: (fg: "#626880"))]))),
              (match: "2.9", replace: (kind: Group([(kind: Text("   "), style: (fg: "#e5c890")), (kind: Text(" "), style: (fg: "#626880"))]))),
              (match: "3", replace: (kind: Group([(kind: Text("   "), style: (fg: "#e5c890")), (kind: Text(" "), style: (fg: "#626880"))]))),
              (match: "3.1", replace: (kind: Group([(kind: Text("   "), style: (fg: "#e5c890")), (kind: Text(" "), style: (fg: "#626880"))]))),
              (match: "3.2", replace: (kind: Group([(kind: Text("   "), style: (fg: "#e5c890")), (kind: Text(" "), style: (fg: "#626880"))]))),
              (match: "3.3", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890")), (kind: Text(""), style: (fg: "#626880"))]))),
              (match: "3.4", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890")), (kind: Text(""), style: (fg: "#626880"))]))),
              (match: "3.5", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890")), (kind: Text(""), style: (fg: "#626880"))]))),
              (match: "3.6", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890")), (kind: Text(""), style: (fg: "#626880"))]))),
              (match: "3.7", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890")), (kind: Text(""), style: (fg: "#626880"))]))),
              (match: "3.8", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890")), (kind: Text(""), style: (fg: "#626880"))]))),
              (match: "3.9", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890")), (kind: Text(""), style: (fg: "#626880"))]))),
              (match: "4", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890")), (kind: Text(""), style: (fg: "#626880"))]))),
              (match: "4.1", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890")), (kind: Text(""), style: (fg: "#626880"))]))),
              (match: "4.2", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890")), (kind: Text(""), style: (fg: "#626880"))]))),
              (match: "4.3", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890"))]))),
              (match: "4.4", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890"))]))),
              (match: "4.5", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890"))]))),
              (match: "4.6", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890"))]))),
              (match: "4.7", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890"))]))),
              (match: "4.8", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890"))]))),
              (match: "4.9", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890"))]))),
              (match: "5", replace: (kind: Group([(kind: Text("    "), style: (fg: "#e5c890"))]))),
            ])), default: (kind: Group([(kind: Text("    "), style: (fg: "#626880"))]))),
          ], align: Right))),
      ])),
      (size: "1", pane: Pane(Property(content: [
            (kind: Property(Song(Other("genre"))), style: (fg: "#838ba7"), default: (kind: Text("-"), style: (fg: "#838ba7"))),
            (kind: Text(" │ "), style: (fg: "#626880")),
            (kind: Property(Song(Other("date"))), style: (fg: "#838ba7"), default: (kind: Text("-"), style: (fg: "#838ba7"))),
            (kind: Text(" │ "), style: (fg: "#626880")),
            (kind: Property(Song(Disc)), style: (fg: "#838ba7"), default: (kind: Text(""))),
            (kind: Text("-"), style: (fg: "#838ba7")),
            (kind: Property(Song(Track)), style: (fg: "#838ba7"), default: (kind: Text("-"), style: (fg: "#838ba7"))),
            (kind: Text(" │ "), style: (fg: "#626880")),
            (kind: Property(Status(Bitrate)), style: (fg: "#838ba7"), default: (kind: Text("0"), style: (fg: "#838ba7"))),
            (kind: Text(" kbps"), style: (fg: "#838ba7")),
          ], align: Left))),
      (size: "1", borders: "TOP", border_symbols: Inherited(parent: Plain, horizontal_top: "╌", horizontal_bottom: "╌"), pane: Pane(Property(content: [(kind: Text(""))]))),
      (size: "1", pane: Split(direction: Horizontal, panes: [
        (size: "100%", pane: Pane(Property(content: [
            (kind: Sticker("playCount"), style: (fg: "#c6d0f5"), default: (kind: Text("0"), style: (fg: "#c6d0f5"))),
            (kind: Text(" "), style: (fg: "#838ba7")),
            (kind: Text(" │ "), style: (fg: "#626880")),
            (kind: Property(Status(QueueLength())), style: (fg: "#c6d0f5")),
            (kind: Text(" 󰴍"), style: (fg: "#838ba7")),
            (kind: Text(" │ "), style: (fg: "#626880")),
            (kind: Property(Status(QueueTimeTotal(separator: " "))), style: (fg: "#c6d0f5")),
            (kind: Text(" 󱎫"), style: (fg: "#838ba7")),
          ], align: Left))),
        (size: "22", pane: Pane(Property(content: [
            (kind: Property(Status(RepeatV2(on_label: "", off_label: "", on_style: (fg: "#e5c890"), off_style: (fg: "#626880"))))),
            (kind: Text("  "), style: (fg: "#626880")),
            (kind: Property(Status(RandomV2(on_label: "", off_label: "", on_style: (fg: "#e5c890"), off_style: (fg: "#626880"))))),
            (kind: Text("  "), style: (fg: "#626880")),
            (kind: Property(Status(ConsumeV2(on_label: "󰮯", off_label: "󰮯", oneshot_label: "󰮯󰇊", oneshot_style: (fg: "#e5c890"), on_style: (fg: "#e5c890"), off_style: (fg: "#626880"))))),
            (kind: Text("  "), style: (fg: "#626880")),
            (kind: Property(Status(SingleV2(on_label: "󰎤", off_label: "󰎦", oneshot_label: "󰇊", off_oneshot_label: "󱅊", oneshot_style: (fg: "#e5c890"), off_oneshot_style: (fg: "#626880"), on_style: (fg: "#e5c890"), off_style: (fg: "#626880"))))),
            (kind: Text(" │ "), style: (fg: "#626880")),
            (kind: Property(Status(Volume)), style: (fg: "#e5c890")),
            (kind: Text("%"), style: (fg: "#e5c890")),
          ], align: Right))),
      ])),
      ]),
      "custom-home": Split(direction: Vertical, panes: [
        (size: "100%", borders: "ALL", border_symbols: Rounded, pane: Split(direction: Vertical, panes: [
          (size: "2", borders: "BOTTOM", border_symbols: Inherited(parent: Plain, horizontal_top: "╌", horizontal_bottom: "╌"), pane: Pane(QueueHeader())),
          (size: "100%", pane: Pane(Queue)),
        ])),
      ]),
    },
    cava: (
      bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
      bar_width: 2, 
      bar_spacing: 1,
      bg_color: None,
      bar_color: Gradient({
        0:    "#babbf1",
